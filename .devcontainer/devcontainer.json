{
  "name": "databricks-docs-vectordb",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",

  "features": {
    "ghcr.io/devcontainers/features/node:1": {},  // Needed for Claude Code
    "ghcr.io/anthropics/devcontainer-features/claude-code:1": {},
    "ghcr.io/devcontainers/features/git:1": {}
  },

  // uv's cache and the project's .venv can sit on different filesystems,
  // which breaks hardlinking and spams warnings. Copy mode avoids that.
  "containerEnv": { "UV_LINK_MODE": "copy" },

  "postCreateCommand": "pipx install uv && (sudo rm -f /etc/apt/sources.list.d/yarn.list && sudo apt-get update && sudo apt-get install -y sqlite3 || true)",

  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "charliermarsh.ruff", "anthropic.claude-code"],
      "settings": { "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python" }
    }
  },

  "mounts": [
    // HOME is unset on Windows hosts; USERPROFILE is unset elsewhere
    "source=${localEnv:HOME}${localEnv:USERPROFILE}/.ssh,target=/home/vscode/.ssh,type=bind,readonly"
  ],
  "remoteUser": "vscode"
}
